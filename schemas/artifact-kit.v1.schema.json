{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Kit repository configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "targets"],
  "properties": {
    "version": { "const": 1 },
    "parameters": { "type": "object", "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }, "additionalProperties": { "type": "string", "maxLength": 4096 } },
    "release": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean", "default": false } } },
    "targets": { "type": "object", "minProperties": 1, "maxProperties": 32, "propertyNames": { "minLength": 1, "maxLength": 80 }, "additionalProperties": { "$ref": "#/$defs/target" } }
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "arch", "steps", "artifacts"],
      "properties": {
        "os": { "enum": ["linux", "darwin", "windows"], "description": "Agent host OS, not application target OS" },
        "arch": { "enum": ["amd64", "arm64"] },
        "executor": { "const": "native", "default": "native" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "signing_profiles": { "type": "array", "items": { "type": "string" } },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 7200 },
        "steps": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/step" } },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?![\\/])(?!.*[\\\\:\\u0000])(?!.*(?:^|/)(?:\\.\\.?|)(?:/|$)).+$" } }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "run"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phase": { "enum": ["build", "sign", "verify"], "default": "build" },
        "shell": { "enum": ["bash", "sh", "powershell", "pwsh"] },
        "run": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 3600 }
      }
    }
  }
}
